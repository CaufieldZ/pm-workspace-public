#!/usr/bin/env bash
# 防腐化 hook：Skill/规则文件变更时自动跑轻量审计 + secret scan
# 激活方式：git config core.hooksPath .githooks

if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN=${PYTHON_BIN:-python3}
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN=${PYTHON_BIN:-python}
else
  echo "❌ 未找到 Python，请安装 Python 3 后再提交"
  exit 1
fi

# -------- Secret scan（所有 commit 都跑）--------
# 匹配常见真 token 格式；占位符（figd_*** / figd_xxx / figp_xxx）和 REDACTED 标记不会误伤
SECRET_PATTERNS='figd_[A-Za-z0-9_-]{30,}|figp_[A-Za-z0-9_-]{30,}|xoxb-[0-9]+-[0-9]+-[A-Za-z0-9]+|sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{80,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{80,}|AKIA[0-9A-Z]{16}|fc-[a-f0-9]{32}|AIza[0-9A-Za-z_-]{35}'

LEAKS=$(git diff --cached -U0 --diff-filter=ACMR | perl -ne 'next unless /^\+/ && !/^\+\+\+/; next if /REDACTED/; print if /(?:'"$SECRET_PATTERNS"')/')

if [ -n "$LEAKS" ]; then
  echo "❌ 检测到疑似 secret 即将入库："
  echo ""
  echo "$LEAKS"
  echo ""
  echo "若为真 secret：① 立即 revoke ② git reset 该文件 ③ 改走本地/env 变量"
  echo "若确为占位符：加 REDACTED 标注或放到 .mcp.json 等已 gitignore 的文件"
  exit 1
fi

if ! "$PYTHON_BIN" scripts/check_staged_large_files.py; then
  exit 1
fi

# -------- 治理变更 ↔ decision note 配对（所有 commit 都跑）--------
# 脚本自读 staged，不依赖下面的 $CHANGED
if ! bash .githooks/check-decision-pair.sh; then
  exit 1
fi

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)

NEEDS_AUDIT=false
# 触发面：Skill / 规则 / hook / pre-commit 本体 + 真相源（settings / 阈值 / 公开同步规则 / 根 README）+ hub 分发包 + 根 scripts
echo "$CHANGED" | grep -qE '^\.claude/skills/|^\.claude/rules/|^\.claude/runbooks/|^\.claude/hooks/|^\.githooks/|^CLAUDE\.md$|^\.claude/settings\.json$|^sync_public\.sh$|^README(\-EN)?\.md$|^\.gitignore$|^hub/|^scripts/' && NEEDS_AUDIT=true

if [ "$NEEDS_AUDIT" = false ]; then
  exit 0
fi

echo "🔍 检测到 Skill/规则/hub/scripts 变更，运行防腐化审计..."
echo ""

# 规则层体积棘轮：单独直调（毫秒级），不把整个 audit 类 5 拉进强制面——
# 类 5.2 遍历所有 skill 要 2.4s，占 pre-commit 全程 23%
if ! "$PYTHON_BIN" scripts/check_rule_volume.py --strict; then
  echo ""
  echo "❌ 规则层体积破棘轮上限，commit 被拦截。"
  exit 1
fi
echo ""

bash .claude/skills/workspace-audit/scripts/audit.sh 1,2,3,4,7,12,13,14,15,16,17,19,20,21,23,25

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ 审计不通过，commit 被拦截。请修复后重新 commit。"
  exit 1
fi

echo ""
echo "✅ 审计通过"

# -------- pytest（改了 Python 才跑）--------
if echo "$CHANGED" | grep -qE '\.py$'; then
  echo ""
  echo "🧪 检测到 Python 变更，跑 pytest..."
  if ! "$PYTHON_BIN" -m pytest scripts/tests/ -q; then
    echo ""
    echo "❌ 测试不通过，commit 被拦截。"
    exit 1
  fi
fi

# Housekeeping warnings（非阻断）
bash .githooks/lib/pre-commit-housekeeping.sh

exit 0
