        <mxCell id="AUTH" value="拦截+引导「去认证」" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FEE3E6;strokeColor=#F6465D;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC,Noto Sans SC,sans-serif;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="426" y="460" width="168" height="50" as="geometry"/></mxCell>
        <mxCell id="READC" value="读取风险等级 C" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7EFFE;strokeColor=#1F2329;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC,Noto Sans SC,sans-serif;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="240" y="460" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="Q2" value="C 级 ≥ R 级?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF3D5;strokeColor=#1F2329;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC,Noto Sans SC,sans-serif;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="215" y="590" width="190" height="70" as="geometry"/></mxCell>
