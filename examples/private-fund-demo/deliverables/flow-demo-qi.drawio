  <diagram id="d_0" name="合格投资者认证流程(R1/R2)">
    <mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="START" value="点击「立即认购」" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E5FF;strokeColor=#1F2329;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC,Noto Sans SC,sans-serif;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="FETCH" value="前端请求 QI 状态" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7EFFE;strokeColor=#1F2329;strokeWidth=1.5;fontSize=12;fontFamily=PingFang SC,Noto Sans SC,sans-serif;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="426" y="180" width="168" height="50" as="geometry"/></mxCell>
